[
  {
    "id": "RBI-DL-001",
    "title": "Disbursement via Non-Borrower Accounts",
    "category": "disbursement_channel",
    "description": "Loan disbursal is routed to wallets, cash, or third-party accounts instead of the borrower bank account",
    "pattern_keywords": ["disburse", "wallet", "prepaid", "third party account", "cash"],
    "severity": "HIGH",
    "version": "1.1",
    "effective_date": "2025-01-01",
    "source": "RBI Guidelines on Digital Lending, 2022",
    "threshold": 0.25,
    "enabled": true
  },
  {
